# Voice API config for production builds
# Set to an endpoint that allows requests from your frontend origin
VITE_VOICE_API_URL=

# Optional: override API key in production
VITE_VOICE_API_KEY=

# Cesium ion access token (optional, but recommended)
VITE_CESIUM_ION_ACCESS_TOKEN=

# HK 3D mesh tileset config
# Prefer setting one of these in real deployments:
# 1) Full URL: VITE_HK_3D_TILESET_URL=https://.../tileset.json?key=YOUR_KEY
# 2) Key only: VITE_HK_3D_TILESET_KEY=YOUR_KEY
VITE_HK_3D_TILESET_URL=
VITE_HK_3D_TILESET_KEY=
